    sudo_group.add(
        "--sudo",
        "--enable-sudo",
        dest="enable_sudo_password",
        action="store_true",
        env_var="AGENTS_ENABLE_SUDO_PASSWORD",
        help="prompt inside the container to set an agent sudo password",
    )

    passthrough_group = parser.add_argument_group("passthrough options")
    passthrough_group.add(
        "--extra-arg",
        "--extra-args",
        dest="extra_args",
        action="append",
        default=[],
        env_var="AGENTS_EXTRA_ARGS",
        help="additional docker/podman run argument; repeatable or TOML list",
    )

    parser.add(
        "tail",
        nargs=argparse.REMAINDER,
        metavar="IMAGE [DOCKER_OR_PODMAN_RUN_ARGS...]",
        help="optional image followed by arguments passed to docker/podman run",
    )
    return parser


def parse_launcher_args(argv: list[str]) -> LauncherConfig:
    parser = build_arg_parser()
    namespace, unknown_args = parser.parse_known_args(argv)

    config = config_from_namespace(namespace)
    tail = list(namespace.tail)
    if tail and tail[0] == "--":
        tail = tail[1:]

    if unknown_args:
        config.extra_args.extend([*unknown_args, *tail])
    elif tail and not tail[0].startswith("-"):
        config.image = tail[0]
        config.extra_args.extend(tail[1:])
    else:
        config.extra_args.extend(tail)

    if namespace.image_option and config.image == DEFAULT_IMAGE:
        config.image = namespace.image_option

    return config


def config_from_namespace(namespace: argparse.Namespace) -> LauncherConfig:
    config = LauncherConfig(
        image=namespace.image_option or DEFAULT_IMAGE,
        runtime=namespace.runtime,
        workspace=namespace.workspace or Path.cwd(),
        command_history_dir=(
            namespace.history_dir or Path.home() / ".local" / "share" / "agents" / "commandhistory"
        ),
        claude_dir=namespace.claude_dir or Path.home() / ".claude",
        claude_json=namespace.claude_json or Path.home() / ".claude.json",
        gemini_dir=namespace.gemini_dir or Path.home() / ".gemini",
        codex_dir=namespace.codex_dir or Path.home() / ".codex",
        venv_dir=namespace.venv_dir or Path.home() / ".agents_venv",
        uv_cache_dir=namespace.uv_cache_dir or Path.home() / ".cache" / "uv",
        container_venv_dir=namespace.container_venv_dir or DEFAULT_CONTAINER_VENV_DIR,
        container_uv_cache_dir=namespace.container_uv_cache_dir or DEFAULT_CONTAINER_UV_CACHE_DIR,
        python_version=namespace.python_version,
        allowed_domains=flatten_list_values(namespace.allowed_domains),
        allowed_cidrs=flatten_list_values(namespace.allowed_cidrs),
        mount_agent_config=namespace.mount_agent_config,
        disable_firewall=namespace.disable_firewall,
        allow_host_network=namespace.allow_host_network,
        keep_firewall_sudo=namespace.keep_firewall_sudo,
        enable_sudo_password=namespace.enable_sudo_password,
        recreate_venv=namespace.recreate_venv,
        dry_run=namespace.dry_run,
        tty=namespace.tty,
        container_name=namespace.container_name,
        timezone=namespace.timezone,
        extra_args=flatten_extra_args(namespace.extra_args),
    )
    return config


def expand_path(value: str) -> Path:
    return Path(value).expanduser().resolve(strict=False)


def validate_container_path(value: str) -> str:
    if not value.startswith("/"):
        raise argparse.ArgumentTypeError("must be an absolute container path")
    normalized = value.rstrip("/") or "/"
    if normalized == "/":
        raise argparse.ArgumentTypeError("cannot be /")
    return normalized


def flatten_list_values(values: list[str] | None) -> list[str]:
    items: list[str] = []
    for value in values or []:
        for chunk in value.replace(",", " ").split():
            if chunk:
                items.append(chunk)
    return items


def flatten_extra_args(values: list[str] | None) -> list[str]:
    args: list[str] = []
    for value in values or []:
        if isinstance(value, str):
            args.extend(shlex.split(value))
        else:
            args.append(value)
    return args


def resolve_runtime(preferred: str | None = None, allow_missing: bool = False) -> str:
    candidates = (preferred,) if preferred else ("podman", "docker")
    for runtime in candidates:
        if runtime and shutil.which(runtime):
            return runtime
    if allow_missing:
        return preferred or "podman"
    if preferred:
        print(f"ERROR: requested runtime not found on PATH: {preferred}", file=sys.stderr)
    else:
        print("ERROR: neither podman nor docker found on PATH", file=sys.stderr)
    sys.exit(1)


def reject_unsafe_extra_args(extra_args: list[str]) -> None:
    if os.environ.get(UNSAFE_OVERRIDE_ENV) == "1":
        return

    violations: list[str] = []
    pending_flag: str | None = None
    for arg in extra_args:
        if pending_flag:
            reason = unsafe_flag_value_reason(pending_flag, arg)
            if reason:
                violations.append(f"{pending_flag} {arg}: {reason}")
            pending_flag = None
            continue

        if arg == "--privileged":
            violations.append("--privileged: disables the container isolation this launcher relies on")
            continue

        if arg in {
            "--network",
            "--net",
            "--pid",
            "--ipc",
            "--uts",
            "--userns",
            "--cap-add",
            "--security-opt",
            "--user",
            "-u",
            "--entrypoint",
            "-v",
            "--volume",
            "--mount",
        }:
            pending_flag = arg
            continue

        if arg == "--device" or arg.startswith("--device="):
            violations.append(f"{arg}: device passthrough can bypass the sandbox")
            continue

        for prefix in (
            "--network=",
            "--net=",
            "--pid=",
            "--ipc=",
            "--uts=",
            "--userns=",
            "--cap-add=",
            "--security-opt=",
            "--user=",
            "--entrypoint=",
            "--volume=",
            "--mount=",
        ):
            if arg.startswith(prefix):
                flag = prefix[:-1]
                value = arg.removeprefix(prefix)
                reason = unsafe_flag_value_reason(flag, value)
                if reason:
                    violations.append(f"{arg}: {reason}")
                break

    if violations:
        formatted = "\n  ".join(violations)
        raise UnsafeRunArg(
            "refusing unsafe container option(s):\n"
            f"  {formatted}\n"
            f"Set {UNSAFE_OVERRIDE_ENV}=1 to pass them through anyway."
        )


def unsafe_flag_value_reason(flag: str, value: str) -> str | None:
    if flag in {"--network", "--net"} and value == "host":
        return "host networking would let the firewall script modify the host network namespace"
    if flag in {"--pid", "--ipc", "--uts"} and value == "host":
        return "sharing host namespaces weakens process and system isolation"
    if flag == "--userns" and value == "host":
        return "sharing the host user namespace weakens filesystem isolation"
    if flag == "--cap-add" and value.upper() not in {"NET_ADMIN", "NET_RAW"}:
        return "extra Linux capabilities are broader than the firewall needs"
    if flag == "--security-opt" and value in {
        "apparmor=unconfined",
        "label=disable",
        "no-new-privileges=false",
        "seccomp=unconfined",
    }:
        return "this disables a runtime security boundary"
    if flag in {"--user", "-u"} and any(part in {"0", "root"} for part in value.split(":")):
        return "running the agent as root would let it alter the container firewall"
    if flag == "--entrypoint":
        return "overriding the entrypoint bypasses Python and firewall initialization"
    if flag in {"-v", "--volume"}:
        source = value.split(":", 1)[0]
        if source == "/":
            return "mounting the host root filesystem exposes the host"
        if source in {"/var/run/docker.sock", "/run/docker.sock"}:
            return "mounting the container runtime socket grants host-level control"
    if flag == "--mount":
        mount_options = parse_mount_options(value)
        source = mount_options.get("source") or mount_options.get("src")
        if source == "/":
            return "mounting the host root filesystem exposes the host"
        if source in {"/var/run/docker.sock", "/run/docker.sock"}:
            return "mounting the container runtime socket grants host-level control"
    return None


def parse_mount_options(value: str) -> dict[str, str]:
    options: dict[str, str] = {}
    for item in value.split(","):
        if "=" not in item:
            continue
        key, mount_value = item.split("=", 1)
        options[key] = mount_value
    return options


def ensure_timezone_env() -> None:
    if os.environ.get("TZ"):
        return
    localtime = Path("/etc/localtime")
    if not localtime.exists():
        return
    resolved = localtime.resolve()
    marker = "/zoneinfo/"
    resolved_str = str(resolved)
    if marker in resolved_str:
        os.environ["TZ"] = resolved_str.split(marker, 1)[1]


def ensure_host_paths(config: LauncherConfig) -> None:
    validate_workspace(config)

    for path in (
        config.command_history_dir,
        config.venv_dir,
        config.uv_cache_dir,
    ):
        path.mkdir(parents=True, exist_ok=True)

    if config.mount_agent_config:
        for path in (config.claude_dir, config.gemini_dir, config.codex_dir):
            path.mkdir(parents=True, exist_ok=True)
        config.claude_json.parent.mkdir(parents=True, exist_ok=True)
        config.claude_json.touch(exist_ok=True)


def validate_workspace(config: LauncherConfig) -> None:
    if not config.workspace.exists() or not config.workspace.is_dir():
        raise ArgumentError(f"workspace must be an existing directory: {config.workspace}")


def validate_config(config: LauncherConfig) -> None:
    if config.enable_sudo_password and not config.tty:
        raise ArgumentError("--sudo requires an interactive TTY; remove --no-tty")

    if config.recreate_venv and is_dangerous_recreate_path(config.venv_dir, config.workspace):
        raise ArgumentError(f"refusing to recreate unsafe venv host path: {config.venv_dir}")

    if config.container_venv_dir in {"/home", "/home/agent"}:
        raise ArgumentError(f"refusing unsafe container venv path: {config.container_venv_dir}")
    if config.container_uv_cache_dir in {"/home", "/home/agent"}:
        raise ArgumentError(f"refusing unsafe container uv cache path: {config.container_uv_cache_dir}")


def is_dangerous_recreate_path(path: Path, workspace: Path) -> bool:
    resolved = path.resolve(strict=False)
    home = Path.home().resolve(strict=False)
    workspace_resolved = workspace.resolve(strict=False)
    return resolved in {Path("/"), home, workspace_resolved}


def build_mounts(config: LauncherConfig) -> list[str]:
    mounts = [
        volume_arg(config.workspace, "/workspace", "z"),
        volume_arg(config.command_history_dir, "/commandhistory", "z"),
        volume_arg(config.venv_dir, config.container_venv_dir, "z"),
        volume_arg(config.uv_cache_dir, config.container_uv_cache_dir, "z"),
    ]

    if config.mount_agent_config:
        mounts.extend(
            [
                volume_arg(config.claude_dir, "/home/agent/.claude", "z"),
                volume_arg(config.gemini_dir, "/home/agent/.gemini", "z"),
                volume_arg(config.codex_dir, "/home/agent/.codex", "z"),
                volume_arg(config.claude_json, "/home/agent/.claude.json", "z"),
            ]
        )
    return mounts


def volume_arg(host_path: Path, container_path: str, options: str) -> str:
    return f"--volume={host_path}:{container_path}:{options}"


def build_env_args(config: LauncherConfig) -> list[str]:
    explicit_env = build_explicit_env(config)
    env_args: list[str] = []

    for name in FORWARDED_SECRET_ENV_NAMES:
        if name in explicit_env:
            continue
        if os.environ.get(name):
            env_args.append(f"--env={name}")

    for name, value in explicit_env.items():
        env_args.append(f"--env={name}={value}")
    return env_args


def build_explicit_env(config: LauncherConfig) -> dict[str, str]:
    env = {
        "UV_PROJECT_ENVIRONMENT": config.container_venv_dir,
        "UV_CACHE_DIR": config.container_uv_cache_dir,
        "UV_LINK_MODE": "copy",
    }

    if config.python_version:
        env["AGENTS_PYTHON_VERSION"] = config.python_version
    if config.allowed_domains:
        env["AGENTS_ALLOWED_DOMAINS"] = ",".join(config.allowed_domains)
    if config.allowed_cidrs:
        env["AGENTS_ALLOWED_CIDRS"] = ",".join(config.allowed_cidrs)
    if config.disable_firewall:
        env["AGENTS_DISABLE_FIREWALL"] = "1"
    if config.allow_host_network:
        env["AGENTS_ALLOW_HOST_NETWORK"] = "1"
    if config.keep_firewall_sudo:
        env["AGENTS_KEEP_FIREWALL_SUDO"] = "1"
    if config.enable_sudo_password:
        env["AGENTS_ENABLE_SUDO_PASSWORD"] = "1"
    if config.recreate_venv:
        env["AGENTS_RECREATE_VENV"] = "1"
    if config.timezone:
        env["TZ"] = config.timezone

    return env


def build_run_command(runtime: str, config: LauncherConfig) -> list[str]:
    command = [runtime, "run", "--rm"]
    if config.tty:
        command.extend(["--interactive", "--tty"])
    if config.container_name:
        command.append(f"--name={config.container_name}")

    command.extend(
        [
            # NET_ADMIN and NET_RAW are required by init-firewall.sh, which uses
            # iptables/ipset to restrict outbound traffic to an allowlist.
            "--cap-add=NET_ADMIN",
            "--cap-add=NET_RAW",
            *build_mounts(config),
            *build_env_args(config),
            *config.extra_args,
            config.image,
        ]
    )
    return command


def main() -> None:
    try:
        config = parse_launcher_args(sys.argv[1:])
        reject_unsafe_extra_args(config.extra_args)
        validate_config(config)
        ensure_timezone_env()
        if config.dry_run:
            validate_workspace(config)
        else:
            ensure_host_paths(config)
    except (ArgumentError, UnsafeRunArg) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        sys.exit(2)

    runtime = resolve_runtime(config.runtime, allow_missing=config.dry_run)
    command = build_run_command(runtime, config)

    print(f"Starting agents container with {runtime}...")
    print(f"  Image    : {config.image}")
    print(f"  Workspace: {config.workspace}")
    if config.enable_sudo_password:
        print("  Sudo     : password setup prompt will run inside the container TTY")

    if config.dry_run:
        print(shlex.join(command))
        return

    os.execvp(runtime, command)


if __name__ == "__main__":
    main()
