ENV_FLAGS = {"--env", "-e"}


def reject_unsafe_extra_args(extra_args: list[str]) -> None:
    if os.environ.get(UNSAFE_OVERRIDE_ENV) == "1":
        return

    violations: list[str] = []
    pending_flag: str | None = None
    for arg in extra_args:
        if pending_flag:
            reason = unsafe_flag_value_reason(pending_flag, arg)
            if reason:
                violations.append(f"{pending_flag} {arg}: {reason}")
            pending_flag = None
            continue

        short_reason = unsafe_short_arg_reason(arg)
        if short_reason:
            violations.append(f"{arg}: {short_reason}")
            continue

        flag, value = split_inline_flag_value(arg)
        if flag in ENV_FLAGS:
            if value is None:
                pending_flag = flag
            else:
                reason = unsafe_flag_value_reason(flag, value)
                if reason:
                    violations.append(f"{arg}: {reason}")
            continue

        if flag in REJECTED_BOOL_FLAGS:
            violations.append(f"{arg}: {REJECTED_BOOL_FLAGS[flag]}")
            continue

        if flag in REJECTED_VALUE_FLAGS:
            if value is None:
                pending_flag = flag
            else:
                violations.append(f"{arg}: {unsafe_flag_value_reason(flag, value)}")
            continue

    if pending_flag:
        violations.append(f"{pending_flag}: missing required value")

    if violations:
        formatted = "\n  ".join(violations)
        raise UnsafeRunArg(
            "refusing unsafe container option(s):\n"
            f"  {formatted}\n"
            f"Set {UNSAFE_OVERRIDE_ENV}=1 to pass them through anyway."
        )


def unsafe_flag_value_reason(flag: str, value: str) -> str | None:
    if flag in ENV_FLAGS:
        name = value.split("=", 1)[0]
        if name in PROTECTED_PASSTHROUGH_ENV_NAMES or any(
            name.startswith(prefix) for prefix in PROTECTED_PASSTHROUGH_ENV_PREFIXES
        ):
            return f"{name} is controlled by the launcher/entrypoint"
        return None
    return REJECTED_VALUE_FLAGS[flag]


def split_inline_flag_value(arg: str) -> tuple[str, str | None]:
    if arg.startswith("--") and "=" in arg:
        flag, value = arg.split("=", 1)
        return flag, value
    return arg, None


def unsafe_short_arg_reason(arg: str) -> str | None:
    if arg in {"-e", "-u", "-v", "-p"}:
        return None
    if arg.startswith("-e") and not arg.startswith("--"):
        value = arg[2:].lstrip("=")
        return unsafe_flag_value_reason("-e", value)
    if arg.startswith("-u") and not arg.startswith("--"):
        return REJECTED_VALUE_FLAGS["-u"]
    if arg.startswith("-v") and not arg.startswith("--"):
        return REJECTED_VALUE_FLAGS["-v"]
    if arg.startswith("-p") and not arg.startswith("--"):
        return REJECTED_VALUE_FLAGS["-p"]
    return None


def ensure_timezone_env() -> None:
    if os.environ.get("TZ"):
        return
    localtime = Path("/etc/localtime")
    if not localtime.exists():
        return
    resolved = localtime.resolve()
    marker = "/zoneinfo/"
    resolved_str = str(resolved)
    if marker in resolved_str:
        os.environ["TZ"] = resolved_str.split(marker, 1)[1]


def ensure_host_paths(config: LauncherConfig) -> None:
    validate_workspace(config)

    for path in (
        config.command_history_dir,
    ):
        path.mkdir(parents=True, exist_ok=True)

    if config.persist_python:
        for path in (config.venv_dir, config.uv_cache_dir):
            path.mkdir(parents=True, exist_ok=True)

    if config.mount_agent_config:
        for path in (config.claude_dir, config.gemini_dir, config.codex_dir):
            path.mkdir(parents=True, exist_ok=True)
        config.claude_json.parent.mkdir(parents=True, exist_ok=True)
        config.claude_json.touch(exist_ok=True)


def validate_workspace(config: LauncherConfig) -> None:
    if not config.workspace.exists() or not config.workspace.is_dir():
        raise ArgumentError(f"workspace must be an existing directory: {config.workspace}")


def validate_config(config: LauncherConfig) -> None:
    if config.enable_sudo_password and not config.tty:
        raise ArgumentError("--sudo requires an interactive TTY; remove --no-tty")

    validate_host_mount_source("workspace", config.workspace)
    validate_host_mount_source("history directory", config.command_history_dir)

    if config.persist_python:
        validate_host_mount_source("venv directory", config.venv_dir)
        validate_host_mount_source("uv cache directory", config.uv_cache_dir)

    if config.mount_agent_config:
        validate_host_mount_source("Claude config directory", config.claude_dir)
        validate_host_mount_source("Gemini config directory", config.gemini_dir)
        validate_host_mount_source("Codex config directory", config.codex_dir)
        validate_host_mount_source("Claude settings file", config.claude_json)

    if config.recreate_venv and config.persist_python and is_dangerous_recreate_path(config.venv_dir, config.workspace):
        raise ArgumentError(f"refusing to recreate unsafe venv host path: {config.venv_dir}")

    if config.persist_python:
        validate_existing_venv_path(config.venv_dir)

    if config.container_venv_dir in {"/home", "/home/agent"}:
        raise ArgumentError(f"refusing unsafe container venv path: {config.container_venv_dir}")
    if config.container_uv_cache_dir in {"/home", "/home/agent"}:
        raise ArgumentError(f"refusing unsafe container uv cache path: {config.container_uv_cache_dir}")
    validate_agent_state_container_path("venv", config.container_venv_dir)
    validate_agent_state_container_path("uv cache", config.container_uv_cache_dir)


def is_dangerous_recreate_path(path: Path, workspace: Path) -> bool:
    resolved = path.resolve(strict=False)
    home = Path.home().resolve(strict=False)
    workspace_resolved = workspace.resolve(strict=False)
    return resolved in {Path("/"), home, workspace_resolved}


def validate_host_mount_source(label: str, path: Path) -> None:
    resolved = path.resolve(strict=False)
    home = Path.home().resolve(strict=False)
    if resolved in {Path("/"), home}:
        raise ArgumentError(f"refusing to mount unsafe host {label}: {path}")

    runtime_sockets = {
        Path("/run/docker.sock"),
        Path("/run/podman/podman.sock"),
        Path("/var/run/docker.sock"),
        Path("/var/run/podman/podman.sock"),
    }
    if resolved in runtime_sockets:
        raise ArgumentError(f"refusing to mount container runtime socket as {label}: {path}")


def validate_existing_venv_path(path: Path) -> None:
    if not path.exists():
        return
    if not path.is_dir():
        raise ArgumentError(f"venv host path exists but is not a directory: {path}")
    if (path / "pyvenv.cfg").is_file():
        return
    try:
        next(path.iterdir())
    except StopIteration:
        return
    raise ArgumentError(
        "venv host path exists, is non-empty, and does not look like a Python "
        f"virtual environment: {path}"
    )


def validate_agent_state_container_path(label: str, value: str) -> None:
    normalized = value.rstrip("/")
    if not normalized.startswith("/home/agent/"):
        raise ArgumentError(f"container {label} path must be under /home/agent: {value}")

    reserved_paths = (
        "/home/agent/.claude",
        "/home/agent/.codex",
        "/home/agent/.gemini",
        "/home/agent/.claude.json",
    )
    for reserved_path in reserved_paths:
        if normalized == reserved_path or normalized.startswith(f"{reserved_path}/"):
            raise ArgumentError(
                f"container {label} path overlaps reserved agent config path: {value}"
            )


def build_mounts(config: LauncherConfig) -> list[str]:
    mounts = [
        volume_arg(config.workspace, "/workspace", "z"),
        volume_arg(config.command_history_dir, "/commandhistory", "z"),
    ]

    if config.persist_python:
        mounts.extend(
            [
                volume_arg(config.venv_dir, config.container_venv_dir, "z"),
                volume_arg(config.uv_cache_dir, config.container_uv_cache_dir, "z"),
            ]
        )

    if config.mount_agent_config:
        config_mount_options = "z" if config.writable_agent_config else "ro,z"
        mounts.extend(
            [
                volume_arg(config.claude_dir, "/home/agent/.claude", config_mount_options),
                volume_arg(config.gemini_dir, "/home/agent/.gemini", config_mount_options),
                volume_arg(config.codex_dir, "/home/agent/.codex", config_mount_options),
                volume_arg(config.claude_json, "/home/agent/.claude.json", config_mount_options),
            ]
        )
    return mounts


def volume_arg(host_path: Path, container_path: str, options: str) -> str:
    return f"--volume={host_path}:{container_path}:{options}"


def build_env_args(config: LauncherConfig) -> list[str]:
    explicit_env = build_explicit_env(config)
    env_args: list[str] = []

    if config.forward_secret_env:
        for name in FORWARDED_SECRET_ENV_NAMES:
            if name in explicit_env:
                continue
            if os.environ.get(name):
                env_args.append(f"--env={name}")

    for name, value in explicit_env.items():
        env_args.append(f"--env={name}={value}")
    return env_args


def build_explicit_env(config: LauncherConfig) -> dict[str, str]:
    env = {
        "UV_PROJECT_ENVIRONMENT": config.container_venv_dir,
        "UV_CACHE_DIR": config.container_uv_cache_dir,
        "UV_LINK_MODE": "copy",
    }

    if config.python_version:
        env["AGENTS_PYTHON_VERSION"] = config.python_version
    if config.allowed_domains:
        env["AGENTS_ALLOWED_DOMAINS"] = ",".join(config.allowed_domains)
    if config.allowed_cidrs:
        env["AGENTS_ALLOWED_CIDRS"] = ",".join(config.allowed_cidrs)
    if config.disable_firewall:
        env["AGENTS_DISABLE_FIREWALL"] = "1"
    if config.allow_host_network:
        env["AGENTS_ALLOW_HOST_NETWORK"] = "1"
    if config.enable_sudo_password:
        env["AGENTS_ENABLE_SUDO_PASSWORD"] = "1"
    if config.recreate_venv:
        env["AGENTS_RECREATE_VENV"] = "1"
    if config.timezone:
        env["TZ"] = config.timezone

    return env


def build_run_command(runtime: str, config: LauncherConfig) -> list[str]:
    command = [runtime, "run", "--rm"]
    if config.tty:
        command.extend(["--interactive", "--tty"])
    if config.container_name:
        command.append(f"--name={config.container_name}")

    command.extend(
        [
            # init-firewall.sh needs NET_ADMIN for iptables during startup.
            # gosu needs SETUID/SETGID so the root entrypoint can drop to agent.
            "--cap-drop=ALL",
            "--cap-add=NET_ADMIN",
            "--cap-add=SETGID",
            "--cap-add=SETUID",
            *([] if config.enable_sudo_password else ["--security-opt=no-new-privileges:true"]),
            *build_mounts(config),
            *build_env_args(config),
            *config.extra_args,
            config.image,
        ]
    )
    return command


def main() -> None:
    try:
        config = parse_launcher_args(sys.argv[1:])
        reject_unsafe_extra_args(config.extra_args)
        validate_config(config)
        ensure_timezone_env()
        if config.dry_run:
            validate_workspace(config)
        else:
            ensure_host_paths(config)
    except (ArgumentError, UnsafeRunArg) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        sys.exit(2)

    runtime = resolve_runtime(config.runtime, allow_missing=config.dry_run)
    command = build_run_command(runtime, config)

    print(f"Starting agents container with {runtime}...")
    print(f"  Image    : {config.image}")
    print(f"  Workspace: {config.workspace}")
    if config.enable_sudo_password:
        print("  Sudo     : password setup prompt will run inside the container TTY")

    if config.dry_run:
        print(shlex.join(command))
        return

    os.execvp(runtime, command)


if __name__ == "__main__":
    main()
