#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.11"
# dependencies = ["configargparse==1.7.5"]
# ///
"""
start-agents - launch the agents container with podman or docker.

Install:
  cp start-agents ~/.local/bin/start-agents
  chmod +x ~/.local/bin/start-agents

Usage:
  start-agents [LAUNCHER_OPTIONS] [IMAGE] [DOCKER_OR_PODMAN_RUN_ARGS...]
  start-agents --config CONFIG.toml [LAUNCHER_OPTIONS] [IMAGE] [DOCKER_OR_PODMAN_RUN_ARGS...]
"""

from __future__ import annotations

import argparse
from collections import OrderedDict
from dataclasses import dataclass, field
import os
from pathlib import Path
import shlex
import shutil
import sys

try:
    import configargparse
except ModuleNotFoundError as error:  # pragma: no cover - handled by uv script mode
    raise SystemExit(
        "ERROR: configargparse is required. Run this script with uv, or install "
        "configargparse into the host Python environment."
    ) from error

DEFAULT_IMAGE = "ghcr.io/varchasgopalaswamy/agents:latest"
DEFAULT_CONTAINER_VENV_DIR = "/home/agent/.venv"
DEFAULT_CONTAINER_UV_CACHE_DIR = "/home/agent/.cache/uv"
UNSAFE_OVERRIDE_ENV = "AGENTS_ALLOW_UNSAFE_FLAGS"
CONFIG_SECTIONS = (
    "start-agents",
    "start-agents.paths",
    "start-agents.python",
    "start-agents.firewall",
    "start-agents.sudo",
)
GROUP_TABLE_KEYS = {"firewall", "paths", "python", "sudo"}

FORWARDED_SECRET_ENV_NAMES = (
    "ANTHROPIC_API_KEY",
    "CLAUDE_API_KEY",
    "GOOGLE_API_KEY",
    "GEMINI_API_KEY",
    "OPENAI_API_KEY",
    "GITHUB_TOKEN",
    "GH_TOKEN",
)


class ArgumentError(ValueError):
    pass


class UnsafeRunArg(ValueError):
    pass


class StartAgentsTomlConfigParser(configargparse.TomlConfigParser):
    def parse(self, stream):
        items = super().parse(stream)
        filtered = OrderedDict()
        for key, value in items.items():
            if key in GROUP_TABLE_KEYS and isinstance(value, str) and value.startswith("{"):
                continue
            filtered[key] = value
        return filtered


@dataclass
class LauncherConfig:
    image: str = DEFAULT_IMAGE
    extra_args: list[str] = field(default_factory=list)
    runtime: str | None = None
    workspace: Path = field(default_factory=Path.cwd)
    command_history_dir: Path = field(
        default_factory=lambda: Path.home() / ".local" / "share" / "agents" / "commandhistory"
    )
    claude_dir: Path = field(default_factory=lambda: Path.home() / ".claude")
    claude_json: Path = field(default_factory=lambda: Path.home() / ".claude.json")
    gemini_dir: Path = field(default_factory=lambda: Path.home() / ".gemini")
    codex_dir: Path = field(default_factory=lambda: Path.home() / ".codex")
    venv_dir: Path = field(default_factory=lambda: Path.home() / ".agents_venv")
    uv_cache_dir: Path = field(default_factory=lambda: Path.home() / ".cache" / "uv")
    container_venv_dir: str = DEFAULT_CONTAINER_VENV_DIR
    container_uv_cache_dir: str = DEFAULT_CONTAINER_UV_CACHE_DIR
    python_version: str | None = None
    allowed_domains: list[str] = field(default_factory=list)
    allowed_cidrs: list[str] = field(default_factory=list)
    mount_agent_config: bool = True
    disable_firewall: bool = False
    allow_host_network: bool = False
    keep_firewall_sudo: bool = False
    enable_sudo_password: bool = False
    recreate_venv: bool = False
    dry_run: bool = False
    tty: bool = True
    container_name: str | None = None
    timezone: str | None = None


def build_arg_parser() -> configargparse.ArgParser:
    parser = configargparse.ArgParser(
        prog="start-agents",
        description="Launch the agents container with podman or docker.",
        epilog=(
            "Launcher options must come before IMAGE. Unknown options are passed "
            "to docker/podman run and dangerous runtime options are refused unless "
            f"{UNSAFE_OVERRIDE_ENV}=1 is set. TOML config files use the "
            "[start-agents] section."
        ),
        config_file_parser_class=StartAgentsTomlConfigParser(CONFIG_SECTIONS),
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
        allow_abbrev=False,
    )

    parser.add(
        "-c",
        "--config",
        is_config_file=True,
        env_var="AGENTS_CONFIG",
        help="read options from a TOML file",
    )
    parser.add(
        "--image",
        dest="image_option",
        env_var="AGENTS_IMAGE",
        help="container image to run",
    )

    launcher_group = parser.add_argument_group("launcher options")
    launcher_group.add(
        "--runtime",
        choices=("docker", "podman"),
        env_var="AGENTS_RUNTIME",
        help="choose a container runtime",
    )
    launcher_group.add(
        "--workspace",
        type=expand_path,
        env_var="AGENTS_WORKSPACE",
        help="host project directory mounted at /workspace",
    )
    launcher_group.add(
        "--name",
        "--container-name",
        dest="container_name",
        env_var="AGENTS_CONTAINER_NAME",
        help="set the container name",
    )
    launcher_group.add(
        "--dry-run",
        action="store_true",
        env_var="AGENTS_DRY_RUN",
        help="print the run command instead of executing it",
    )
    launcher_group.add(
        "--tty",
        action=argparse.BooleanOptionalAction,
        default=True,
        env_var="AGENTS_TTY",
        help="allocate an interactive TTY",
    )
    launcher_group.add("--timezone", env_var="TZ", help="container TZ value")

    path_group = parser.add_argument_group("persistent path options")
    path_group.add(
        "--history-dir",
        type=expand_path,
        env_var="AGENTS_HISTORY_DIR",
        help="host bash history directory",
    )
    path_group.add(
        "--venv-dir",
        type=expand_path,
        env_var="AGENTS_VENV_DIR",
        help="host Python venv directory",
    )
    path_group.add(
        "--container-venv-dir",
        type=validate_container_path,
        env_var="AGENTS_CONTAINER_VENV_DIR",
        help="container Python venv path",
    )
    path_group.add(
        "--uv-cache-dir",
        type=expand_path,
        env_var="AGENTS_UV_CACHE_DIR",
        help="host uv cache directory",
    )
    path_group.add(
        "--container-uv-cache-dir",
        type=validate_container_path,
        env_var="AGENTS_CONTAINER_UV_CACHE_DIR",
        help="container uv cache path",
    )
    path_group.add(
        "--claude-dir",
        type=expand_path,
        env_var="AGENTS_CLAUDE_DIR",
        help="host Claude config directory",
    )
    path_group.add(
        "--claude-json",
        type=expand_path,
        env_var="AGENTS_CLAUDE_JSON",
        help="host Claude settings file",
    )
    path_group.add(
        "--gemini-dir",
        type=expand_path,
        env_var="AGENTS_GEMINI_DIR",
        help="host Gemini config directory",
    )
    path_group.add(
        "--codex-dir",
        type=expand_path,
        env_var="AGENTS_CODEX_DIR",
        help="host Codex config directory",
    )
    path_group.add(
        "--mount-agent-config",
        "--agent-config",
        action=argparse.BooleanOptionalAction,
        default=True,
        env_var="AGENTS_MOUNT_AGENT_CONFIG",
        help="mount Claude/Gemini/Codex config directories",
    )

    python_group = parser.add_argument_group("Python options")
    python_group.add(
        "--python",
        "--python-version",
        dest="python_version",
        env_var="AGENTS_PYTHON_VERSION",
        help="Python version passed to uv when creating the venv",
    )
    python_group.add(
        "--recreate-venv",
        action="store_true",
        env_var="AGENTS_RECREATE_VENV",
        help="delete and recreate the mounted venv on startup",
    )

    firewall_group = parser.add_argument_group("firewall options")
    firewall_group.add(
        "--allow-domain",
        "--allowed-domain",
        "--allow-domains",
        "--allowed-domains",
        dest="allowed_domains",
        action="append",
        default=[],
        env_var="AGENTS_ALLOWED_DOMAINS",
        help="add one or more outbound allowlist domains",
    )
    firewall_group.add(
        "--allow-cidr",
        "--allow-cidrs",
        "--allowed-cidrs",
        dest="allowed_cidrs",
        action="append",
        default=[],
        env_var="AGENTS_ALLOWED_CIDRS",
        help="add one or more outbound allowlist IPv4 CIDRs/IPs",
    )
    firewall_group.add(
        "--disable-firewall",
        "--no-firewall",
